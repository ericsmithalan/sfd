{
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext", "es2017.object"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true
    },
    "include": [
        "next-env.d.ts",
        "./src/default.d.ts",
        "**/*.ts",
        "**/*.tsx",
        "src/views/outliner/index.old",
        "src/utils/edgesGeometry",
        "src/lib/Model.old",
        "scripts/textures.js"
, "src/app/outliner/projects/index copy.old", "src/components/panel-dropdown/index copy.old"    ],
    "exclude": ["node_modules"]
}
