.panel-dropdown {
    display: flex;
    flex-direction: column;
    backdrop-filter: var(--blur-3);
    box-shadow: var(--shadow-1);
    border-radius: var(--radius-6);
    border: 1px solid var(--color-dark-4);
    padding: var(--padding-3);
    margin-top: var(--margin-4);
    margin-left: var(--margin-4);
    z-index: 100;
    margin-right: var(--margin-4);
    background-color: var(--color-white-7);
    cursor: pointer;

    & > .layout {
        display: flex;
        flex-direction: row;
        flex: 1 1 auto;
        z-index: 101;

        & > .layout-title {
            display: flex;
            flex-direction: row;
            gap: 0;
            flex: 1 1 auto;
            gap: var(--gap-6);

            & > .title {
                padding: 0;
                margin: 0;
                height: auto;
                width: auto;
            }

            & > .selected {
                flex: 1 1 auto;
                padding: 0;
                margin: 0;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
                max-width: 500px;
                min-width: 50px;
                width: 100%;
            }
        }

        & > .dropdown-toggle {
            display: flex;
            padding: 0;
            margin: 0;
            margin-left: var(--margin-4);
        }
    }

    &.mobile {
        position: absolute;
        top: var(--margin-4);
        left: var(--margin-4);
        right: var(--margin-4);
        padding-top: var(--padding-1);
        padding-bottom: var(--padding-1);
        font-size: var(--font-5);
    }

    & > .inner-border {
        position: absolute;
        left: 0;
        top: 0;
        right: 0;
        bottom: 0;
        border: 1px solid var(--color-white-8);
        border-radius: var(--radius-6);
        z-index: 0;
    }

    & > .border-highlight {
        position: absolute;
        top: 0px;
        left: 0;
        right: 0;
        height: 1px;
        opacity: 0.2;
    }
}

.dropdown {
    display: flex;
    flex-direction: column;
    width: 262px;
    z-index: 100;
    position: absolute;
    top: 62px;
    left: 15px;
    background-color: var(--color-white-8) !important;
    backdrop-filter: var(--blur-1);
    box-shadow: var(--shadow-1);
    border-radius: var(--radius-6);

    & > .dropdown-items {
        position: relative;
        z-index: 300;
        display: flex;
        flex: 1 1 auto;
        height: 280px;
    }

    &.mobile {
        position: absolute;
        top: 70px;
        left: var(--margin-4);
        right: var(--margin-4);
        flex: 1 1 auto;
        width: auto;
        height: 240px;
    }
}
